{
  "protocol_version": "mmlsv2_remote_sensing_v2",
  "description": "Paper-grade first-round protocol on converted MMLSv2. The mapped data preserve the competition-like 7-channel Mars representation; the fixed MARS training-protocol mean/std is applied unchanged to validation/test.",
  "seeds": [41, 42, 43],
  "groups": ["core", "ablations"],
  "common": {
    "data_root": "",
    "train_split": "train",
    "val_split": "val",
    "split_file": "",
    "fold": -1,
    "output_dir": "outputs_experiments/paper_mmlsv2",
    "summary_csv": "outputs_experiments/paper_mmlsv2/summary.csv",
    "model_name": "custom",
    "arch": "segformer",
    "encoder": "tu-convnext_small",
    "pretrain": true,
    "channels1": "0,1,2",
    "channels2": "3,4,5,6",
    "fusion": "add",
    "in_channels": 7,
    "input_channels": "0,1,2,3,4,5,6",
    "num_classes": 2,
    "input_size": 128,
    "batch_size": 16,
    "max_train_samples": 0,
    "max_val_samples": 0,
    "epochs": 100,
    "lr": 0.0001,
    "weight_decay": 0.0005,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "loss": "combined",
    "ignore_index": 255,
    "augmentation": "mars",
    "aug_prob": 0.5,
    "mosaic_prob": 0.5,
    "num_workers": 4,
    "device": "cuda:0",
    "mixed_precision": false,
    "deterministic": true,
    "resume": "",
    "init_checkpoint": "",
    "val_interval": 1,
    "save_interval": 1,
    "primary_metric": "miou",
    "early_stopping_patience": 0,
    "min_delta": 0.0,
    "normalization": "train",
    "dataset_type": "mars_ls",
    "use_file_list_dataset": true,
    "save_auxiliary_checkpoints": false,
    "finalize_results": true,
    "final_output_dir": "",
    "dry_run": false,
    "skip_model_init": false
  },
  "experiments": [
    {
      "id": "M1",
      "group": "core",
      "experiment_name": "M1_unet_resnet50",
      "arch": "unet",
      "encoder": "resnet50",
      "in_channels": 7
    },
    {
      "id": "M2",
      "group": "core",
      "experiment_name": "M2_deeplabv3plus_resnet50",
      "arch": "deeplabv3plus",
      "encoder": "resnet50",
      "in_channels": 7
    },
    {
      "id": "M3",
      "group": "core",
      "experiment_name": "M3_segformer_mitb2",
      "arch": "segformer",
      "encoder": "mit_b2",
      "in_channels": 7
    },
    {
      "id": "M4",
      "group": "core",
      "experiment_name": "M4_single_convnext_small_mlp",
      "arch": "segformer",
      "encoder": "tu-convnext_small",
      "in_channels": 7
    },
    {
      "id": "M5",
      "group": "core",
      "experiment_name": "M5_dualsegformer_small",
      "arch": "dual_segformer",
      "encoder": "tu-convnext_small",
      "channels1": "0,1,2",
      "channels2": "3,4,5,6",
      "fusion": "add",
      "in_channels": 7
    },
    {
      "id": "A1",
      "group": "ablations",
      "experiment_name": "A1_optical_only_single_small",
      "arch": "segformer",
      "encoder": "tu-convnext_small",
      "input_channels": "3,4,5,6",
      "in_channels": 4
    },
    {
      "id": "A2",
      "group": "ablations",
      "experiment_name": "A2_physical_only_single_small",
      "arch": "segformer",
      "encoder": "tu-convnext_small",
      "input_channels": "0,1,2",
      "in_channels": 3
    },
    {
      "id": "A5",
      "group": "ablations",
      "experiment_name": "A5_approx_capacity_control_convnext_base",
      "arch": "segformer",
      "encoder": "tu-convnext_base",
      "input_channels": "0,1,2,3,4,5,6",
      "in_channels": 7,
      "notes": "近似容量对照：单流 ConvNeXt-Base + MLP Decoder；最终以实测 Params/GFLOPs 报告容量偏差。"
    },
    {
      "id": "B2",
      "group": "ablations",
      "experiment_name": "B2_group_rgb_vs_physical_grayscale",
      "arch": "dual_segformer",
      "encoder": "tu-convnext_small",
      "channels1": "4,5,6",
      "channels2": "0,1,2,3",
      "fusion": "add",
      "in_channels": 7
    },
    {
      "id": "B3",
      "group": "ablations",
      "experiment_name": "B3_mixed_channel_grouping",
      "arch": "dual_segformer",
      "encoder": "tu-convnext_small",
      "channels1": "0,2,3",
      "channels2": "1,4,5,6",
      "fusion": "add",
      "in_channels": 7
    },
    {
      "id": "C2",
      "group": "ablations",
      "experiment_name": "C2_concat_fusion",
      "arch": "dual_segformer",
      "encoder": "tu-convnext_small",
      "channels1": "0,1,2",
      "channels2": "3,4,5,6",
      "fusion": "cat",
      "in_channels": 7
    }
  ]
}
